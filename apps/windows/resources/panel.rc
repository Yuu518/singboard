#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif
#define SB_STR_INNER(x) #x
#define SB_STR(x) SB_STR_INNER(x)
#define SB_VER_STR SB_STR(VER_MAJOR) "." SB_STR(VER_MINOR) "." SB_STR(VER_PATCH) ".0"

1 ICON "icons/icon.ico"
1 24 "singboard.exe.manifest"

1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Singboard"
            VALUE "FileVersion", SB_VER_STR
            VALUE "InternalName", "singboard"
            VALUE "OriginalFilename", "singboard.exe"
            VALUE "ProductName", "Singboard"
            VALUE "ProductVersion", SB_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
